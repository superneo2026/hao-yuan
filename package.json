{
  "name": "haoyuan",
  "version": "1.0.0",
  "description": "豪源 · HaoYuan — 个人指挥 AI 实现多个 AI 员工异步并行工作的 AI 工作室",
  "bin": {
    "haoyuan": "bin/haoyuan.js"
  },
  "files": [
    "bin/",
    "api/**",
    "!api/env1/**",
    "!api/data/**",
    "api/data/.gitkeep",
    "!api/**/__pycache__/**",
    "!api/**/*.pyc",
    "web/**",
    "!web/node_modules/**",
    "!web/dist/**",
    "desktop/",
    "docs/",
    "start.sh",
    "stop.sh",
    "start.bat",
    "stop.bat",
    "dev.bat",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "postinstall": "node bin/haoyuan.js setup",
    "setup": "node bin/haoyuan.js setup",
    "build": "node bin/haoyuan.js build",
    "start": "node bin/haoyuan.js start"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
