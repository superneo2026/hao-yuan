{
  "name": "embodied",
  "title": "Embodied Harness",
  "version": "1.0.0",
  "description": "Embodied agent harness plugin: robot state, sensors, motion, and emergency stop tools with a demo HTTP bridge.",
  "author": "HaoYuan",
  "requires": ["coding"],
  "default_enabled": false,
  "backend": "plugin.py",
  "routes": "routes.py",
  "contributes": {
    "agents": ["robot"],
    "tools": ["robot_status", "robot_scan", "robot_stop", "robot_estop", "robot_reset_estop", "robot_move", "robot_turn", "robot_goto"],
    "frontend": {
      "nav": [{ "label": "Robotics", "path": "/robotics", "icon": "cpu" }]
    }
  }
}
